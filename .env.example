# ─────────────────────────────────────────────────────────────
# PinHunter settings. Copy to .env (or run: pinhunter init).
# Never commit .env — it holds your keys.
# ─────────────────────────────────────────────────────────────

# ── 1. Your AI ───────────────────────────────────────────────
# AI_PROVIDER: gemini | grok | openai | anthropic | groq | openrouter | deepseek | mistral | ollama | lmstudio | custom
AI_PROVIDER=gemini
AI_API_KEY=
# Model name from your provider, e.g. gemini-2.5-flash, grok-4, gpt-4o-mini, claude-sonnet-5-5, llama3.1
AI_MODEL=
# Only for "custom" (any OpenAI-compatible API) or to override a preset
AI_BASE_URL=

# ── 2. Google Sheet (your draft queue) ──────────────────────
# The long ID in the Sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Path to the service account key file (share the Sheet with its client_email as Editor)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# ...or paste the whole JSON (or base64 of it) here instead — handy for GitHub Actions secrets
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── 3. Pinterest ─────────────────────────────────────────────
# From https://developers.pinterest.com/apps/  (then run: pinhunter auth)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8085/callback
# Filled in by "pinhunter auth"
PINTEREST_REFRESH_TOKEN=
PINTEREST_ACCESS_TOKEN=
# true = post to the Pinterest sandbox (testing before Standard access)
PINTEREST_SANDBOX=false

# ── 4. Product sources (enable them in pinhunter.config.json) ─
# AliExpress Affiliate API: https://openservice.aliexpress.com  (Affiliate → App)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Amazon Creators API (beta): Associates Central → Tools → Creators API
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# Version shown next to your credentials: 2.1/2.2/2.3 or 3.1/3.2/3.3
AMAZON_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=
# Optional; defaults from market.country, e.g. www.amazon.com
AMAZON_MARKETPLACE=

# ── 5. "Drafts ready" ping (optional) ────────────────────────
# A Discord or Slack incoming-webhook URL
NOTIFY_WEBHOOK_URL=
